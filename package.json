{
  "name": "picx",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "echo '⛔ blocked: prod uses wrangler d1_migrations; drizzle-kit migrate would re-run from 0000 (0001/0002 contain DELETE). use: wrangler d1 migrations apply DB --remote' && exit 1",
    "db:push": "echo '⛔ blocked: drizzle-kit push writes prod directly (incl. short_id table rebuild) and bypasses migration history. use db:generate + wrangler d1 migrations apply' && exit 1",
    "db:pull": "echo '⛔ blocked: drizzle-kit pull introspects prod and overwrites hand-maintained schema.ts. run manually only if you really need it' && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:backfill-tldr": "node scripts/backfill-tldr.mjs",
    "db:backfill-categories": "node scripts/backfill-categories.mjs",
    "db:backfill-upvotes": "node scripts/backfill-upvotes.mjs",
    "db:backfill-paper-text": "node scripts/backfill-paper-text.mjs",
    "db:backfill-paper-content": "tsx scripts/backfill-paper-content.mjs",
    "db:backfill-paper-text-from-content": "tsx scripts/backfill-paper-text-from-content.mjs",
    "db:backfill-clean-garble": "tsx scripts/backfill-clean-garble.mjs",
    "db:backfill-fffd-repair": "tsx scripts/backfill-fffd-repair.mjs",
    "db:backfill-news-excerpts": "tsx scripts/backfill-news-excerpts.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "check": "biome check && tsc --noEmit"
  },
  "dependencies": {
