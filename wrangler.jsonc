{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "picx",
  "main": "src/server.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,

  // Cron triggers
  "triggers": {
    "crons": [
      "0 0 * * *", // 08:00 北京时间: arxiv-cron 拉取并生成白板
      "0 14 * * *", // 22:00 北京时间: tweet-poster-cron 发当天 top-1（北美早高峰）
      "30 14 * * *", // 22:30 北京时间: tweet-poster-cron 发当天 top-2
      "0 15 * * *", // 23:00 北京时间: tweet-poster-cron 发当天 top-3
      "0 * * * *", // 每小时: news-cron 新闻聚合流水线（00:00 会与 arxiv-cron 各自独立触发，互不影响）
      "0 12 * * SAT" // 东京周六 21:00: digest-cron 方向周报挖掘（CF cron 星期是 1=周日..7=周六，数字 6 是周五，故用缩写）
    ]
  },


  // Environment variables
  "vars": {
    "ENVIRONMENT": "production"
  },

  // Workers AI binding
  "ai": { "binding": "AI" },

  // D1 数据库配置
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "picx-db",
      "database_id": "510f4d6e-1740-4db4-8a96-3823cdaf9bc4",
      "migrations_dir": "drizzle"
    }
  ],

  // R2 对象存储配置
  "r2_buckets": [
    {
      "binding": "PAPERS_BUCKET",
      "bucket_name": "picx-papers-apac",
      "preview_bucket_name": "picx-papers-apac-preview"
    }
  ],

  // Queues 配置
  "queues": {
    "producers": [
      {
        "binding": "PAPER_QUEUE",
        "queue": "paper-processing"
      }
    ],
    "consumers": [
      {
        "queue": "paper-processing",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "paper-processing-dlq",
        // MinerU zip 解析吃大量内存: 高并发同时处理会把多份大 buffer 挤进同一个
        // isolate 引发 OOM 被平台击杀; 限流到 2 并发降低撞峰概率。零延迟重投会让
        // 被杀的消息立刻在同一时刻再挤一次内存, 加个重试延迟错开重投时间。
        "max_concurrency": 2,
        "retry_delay": 120
      },
      {
        // DLQ 消费者: 4 次投递全部失败(通常是 isolate 被杀, 代码 catch 没机会跑)
        // 后落到这里, 立即把仍在途的论文标 failed 并写真实原因, 而不是留着当
        // 僵尸行等 24h watchdog 收尸。
        "queue": "paper-processing-dlq",
        "max_batch_size": 5,
        "max_retries": 3
      }
    ]
  },

  // Workflows 配置
  "workflows": [
    {
      "binding": "DIGEST_WORKFLOW",
      "name": "digest-workflow",
      "class_name": "DigestWorkflow"
    }
  ],

  // 聊天生成宿主 DO：生成寿命与客户端连接解耦（断连不丢回复 + resume）
  "durable_objects": {
    "bindings": [{ "name": "CHAT_RUNNER", "class_name": "ChatRunner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRunner"] }],

  // 本地开发配置
  "dev": {
    "port": 3000,
    "local_protocol": "http"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
