{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "picx",
  "main": "src/server.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,

  // Cron triggers
  "triggers": {
    "crons": [
      "0 0 * * *", // 08:00 北京时间: arxiv-cron 拉取并生成白板
      "0 14 * * *", // 22:00 北京时间: tweet-poster-cron 发当天 top-1（北美早高峰）
      "30 14 * * *", // 22:30 北京时间: tweet-poster-cron 发当天 top-2
      "0 15 * * *", // 23:00 北京时间: tweet-poster-cron 发当天 top-3
      "0 * * * *", // 每小时: news-cron 新闻聚合流水线（00:00 会与 arxiv-cron 各自独立触发，互不影响）
      "0 12 * * 6" // 东京周六 21:00: digest-cron 方向周报挖掘
    ]
  },


  // Environment variables
  "vars": {
    "ENVIRONMENT": "production"
  },

  // Workers AI binding
  "ai": { "binding": "AI" },

  // D1 数据库配置
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "picx-db",
      "database_id": "510f4d6e-1740-4db4-8a96-3823cdaf9bc4",
      "migrations_dir": "drizzle"
    }
  ],

  // R2 对象存储配置
  "r2_buckets": [
    {
      "binding": "PAPERS_BUCKET",
      "bucket_name": "picx-papers-apac",
      "preview_bucket_name": "picx-papers-apac-preview"
    }
  ],

  // Queues 配置
  "queues": {
    "producers": [
      {
        "binding": "PAPER_QUEUE",
        "queue": "paper-processing"
      }
    ],
    "consumers": [
      {
        "queue": "paper-processing",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "paper-processing-dlq"
      }
    ]
  },

  // Workflows 配置
  "workflows": [
    {
      "binding": "DIGEST_WORKFLOW",
      "name": "digest-workflow",
      "class_name": "DigestWorkflow"
    }
  ],

  // 本地开发配置
  "dev": {
    "port": 3000,
    "local_protocol": "http"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
